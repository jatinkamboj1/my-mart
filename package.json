{
  "name": "e-store",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix StoreUI run dev",
    "dev:backend": "npm --prefix StoreService run dev",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "npm --prefix StoreUI run start",
    "start:backend": "npm --prefix StoreService run start",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix StoreUI run build",
    "build:backend": "npm --prefix StoreService run build",
    "postinstall": "npm --prefix StoreUI install && npm --prefix StoreService install",
    "postinstall:frontend": "npm --prefix StoreUI install",
    "postinstall:backend": "npm --prefix StoreService install",
    "start:electron": "npm run ui",
    "ui": "npm --prefix StoreUI run start",
    "electron": "node -e \"console.log('Electron is not configured for this project')\"",
    "deploy": "npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.62.16",
    "aws-sdk": "^2.1692.0",
    "concurrently": "^8.2.2",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.0",
    "react-datepicker": "^7.6.0",
    "react-hot-toast": "^2.5.1"
  }
}
